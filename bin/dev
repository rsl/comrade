#!/usr/bin/env ruby
# Foreground dev server: bin/dev [server flags] — plain passthrough to
# `rails server`, with the COMRADE_PORT/PORT mapping below.
#
# Background daemon: bin/dev start|stop|restart|status|logs — detached
# processes (web + GoodJob worker) logging to log/dev-server.log with pids
# in tmp/pids/devd.pid and tmp/pids/jobsd.pid.

require 'socket'

def dev_port
  ENV['COMRADE_PORT'] || ENV['PORT'] || stored_port || '3000'
end

# The running server's port, recorded at start — status/stop must describe
# the running process even from a shell without the exports.
def stored_port
  File.read('tmp/pids/devd.port').strip
rescue Errno::ENOENT
  nil
end

def start_port
  ENV['COMRADE_PORT'] || ENV['PORT'] || stored_port || '3000'
end
PIDFILE = 'tmp/pids/devd.pid'
JOBS_PIDFILE = 'tmp/pids/jobsd.pid'
PORTFILE = 'tmp/pids/devd.port'
LOGFILE = 'log/dev-server.log'

def pid(pidfile = PIDFILE)
  File.read(pidfile).to_i
rescue Errno::ENOENT
  nil
end

def alive?(process_pid)
  Process.kill(0, process_pid)
  true
rescue Errno::ESRCH, Errno::EPERM
  false
end

def running?(pidfile = PIDFILE)
  process_pid = pid(pidfile)
  process_pid && alive?(process_pid)
end

def port_open?
  TCPSocket.new('127.0.0.1', dev_port).close
  true
rescue Errno::ECONNREFUSED
  false
end

def wait_for_port(seconds)
  (seconds * 2).times do
    return true if port_open?

    sleep 0.5
  end
  false
end

def start_server
  abort "already running (pid #{ pid })" if running?

  File.write(PORTFILE, start_port)
  jobs = Process.spawn('./bin/jobs', out: [LOGFILE, 'a'], err: [:child, :out], pgroup: true)
  File.write(JOBS_PIDFILE, jobs)
  spawned = Process.spawn({ 'PORT' => start_port }, './bin/dev', out: [LOGFILE, 'a'], err: [:child, :out], pgroup: true)
  File.write(PIDFILE, spawned)
  Process.detach(jobs)
  Process.detach(spawned)
  if wait_for_port(15)
    puts "comrade dev server on port #{ start_port } (pid #{ spawned }, jobs pid #{ jobs }, log #{ LOGFILE })"
  else
    puts "server did not come up on port #{ start_port } — last log lines:"
    system('tail', '-n', '20', LOGFILE)
    exit 1
  end
end

def stop_process(pidfile)
  current = pid(pidfile)
  return unless current && alive?(current)

  Process.kill('TERM', current)
  20.times do
    break unless alive?(current)

    sleep 0.25
  end
  Process.kill('KILL', current) if alive?(current)
  File.delete(pidfile)
  current
end

def stop_server
  abort 'not running' if !running?(PIDFILE) && !running?(JOBS_PIDFILE)

  jobs_pid = stop_process(JOBS_PIDFILE)
  web_pid = stop_process(PIDFILE)
  puts "stopped (web pid #{ web_pid }, jobs pid #{ jobs_pid })"
end

case ARGV.first
when 'start'
  start_server
when 'stop'
  stop_server
when 'restart'
  stop_server if running?(PIDFILE) || running?(JOBS_PIDFILE)
  start_server
when 'status'
  if running?(PIDFILE)
    state = port_open? ? 'answering' : 'booting'
    jobs_state = running?(JOBS_PIDFILE) ? "jobs pid #{ pid(JOBS_PIDFILE) }" : 'jobs stopped'
    puts "running (pid #{ pid }, port #{ dev_port }, #{ state }, #{ jobs_state })"
  else
    puts 'stopped'
  end
when 'logs'
  abort "no log at #{ LOGFILE } — never started?" unless File.exist?(LOGFILE)

  exec 'tail', '-n', '50', '-f', LOGFILE
else
  # Foreground passthrough — flags and bare invocation go to rails server.
  ENV['PORT'] = ENV['COMRADE_PORT'] if ENV['COMRADE_PORT']
  exec './bin/rails', 'server', *ARGV
end