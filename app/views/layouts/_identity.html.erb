<%# Identity: the chip says who this browser is — the name, or the commune
    when anon. The doors are permanent: enlist/claim by name (a name that
    exists is claimed, a new one enlists), step out back to the commune.
    Copy is first-pass; the tweaking stage owns the final words. The
    identity-banner controller on the section announces silent identity
    changes once. %>
<%= tag.section class: 'mb-4 border-b border-soviet/30 pb-3', data: {
      controller: 'identity-banner',
      comrade_name: identity_chip,
      announce_identity: identity_changed ? 'false' : 'true', } do %>
  <% if current_enlistee %>
    <div class="flex items-center justify-between">
      <span class="text-sm text-neutral-300">asking as <%= current_enlistee.name %></span>
      <%= link_to 'step out', enlistment_path, title: 'Back to the commune',
            data: { turbo_method: :delete },
            class: 'cursor-pointer text-xs text-neutral-500 hover:text-neutral-200' %>
    </div>
  <% else %>
    <span class="text-sm text-neutral-300">asking as the commune</span>
    <%= tag.details open: enlistee_seen? ? nil : true, class: 'mt-1' do %>
      <%= tag.summary 'enlist', class: 'cursor-pointer text-xs text-neutral-500 hover:text-neutral-200' %>
      <%= form_with url: enlistment_path, class: 'mt-2 flex items-center gap-1' do |form| %>
        <%= form.text_field :name, required: true, maxlength: 40, autocomplete: 'off',
              placeholder: 'what should we call you?',
              class: 'w-full min-w-0 rounded bg-soviet/20 px-2 py-1 text-sm text-neutral-200 placeholder:text-neutral-500 focus:outline-none' %>
        <%= form.button 'enlist', class: 'cursor-pointer rounded bg-soviet/50 px-2 py-1 text-xs text-neutral-100 hover:bg-soviet' %>
      <% end %>
      <% unless enlistee_seen? %>
        <%= link_to 'not enlisting today', new_enlistment_path, class: 'mt-1 block text-xs text-neutral-500 hover:text-neutral-200' %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
