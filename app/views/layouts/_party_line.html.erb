<%# Party Line: how comrade talks to you — one free-text directive line,
    editable anytime, blank save is the reset. Lives in the identity
    section as a sentence link, always underlined — the link is the
    affordance; opening toggles the field. Rendered only for comrades —
    the identity section guards presence; the commune has no row to
    write to. The calibration offer surfaced here once; it lives in the
    conversation now, under the answers that earned it. Copy is
    first-pass; the tweaking stage owns the final words. %>
<%= tag.details class: 'group mt-2' do %>
  <%= tag.summary class: 'cursor-pointer list-none underline text-xs text-neutral-500 hover:text-neutral-200' do %>
    Change the party line?
  <% end %>
  <%= form_with url: enlistment_path, method: :patch, class: 'mt-2' do %>
    <%= tag.textarea current_enlistee.prefs&.[]('line'), name: 'line', rows: 3,
          placeholder: 'How should comrade talk to you?', autocomplete: 'off',
          class: 'w-full rounded bg-soviet/20 px-2 py-1 text-sm text-neutral-200 placeholder:text-neutral-500 focus:outline-none' %>
    <%= tag.button 'save', type: 'submit',
          class: 'mt-1 cursor-pointer rounded bg-soviet/50 px-2 py-1 text-xs text-neutral-100 hover:bg-soviet' %>
  <% end %>
<% end %>
