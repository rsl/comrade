<%# Party Line: how comrade talks to you. One free-text directive line,
    editable anytime, blank save is the reset. Enlisted comrades only —
    the commune keeps the factory voice and has no row to write to.
    Copy is first-pass; the tweaking stage owns the final words. %>
<% if current_enlistee %>
  <%= tag.details class: 'mt-3 border-t border-soviet/30 pt-3' do %>
    <%= tag.summary 'party line', class: 'cursor-pointer text-xs uppercase tracking-wide text-neutral-500 hover:text-neutral-200' %>
    <% if current_enlistee.offer_keep_simple? %>
      <%# The calibration offer: one quiet question, asked once. %>
      <div class="mt-2 text-xs text-neutral-400">
        keep answers simpler by default?
        <%= link_to 'yes', calibration_path, data: { turbo_method: :post }, class: 'cursor-pointer underline hover:text-neutral-200' %>
        <%= link_to 'not now', calibration_path, data: { turbo_method: :delete }, class: 'cursor-pointer text-neutral-500 hover:text-neutral-200' %>
      </div>
    <% end %>
    <%= form_with url: enlistment_path, method: :patch, class: 'mt-2' do %>
      <%= tag.textarea current_enlistee.prefs&.[]('line'), name: 'line', rows: 3,
            placeholder: 'how should comrade talk to you?', autocomplete: 'off',
            class: 'w-full rounded bg-soviet/20 px-2 py-1 text-sm text-neutral-200 placeholder:text-neutral-500 focus:outline-none' %>
      <%= tag.button 'save', type: 'submit',
            class: 'mt-1 cursor-pointer rounded bg-soviet/50 px-2 py-1 text-xs text-neutral-100 hover:bg-soviet' %>
    <% end %>
  <% end %>
<% end %>
