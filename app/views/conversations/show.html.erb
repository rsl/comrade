<p class="mx-auto max-w-3xl flex items-center gap-3 px-5 pt-10 text-sm truncate text-neutral-500">
  <span class="grow truncate"><%= @conversation.title.presence || '(untitled)' %></span>
  <% if @conversation.archived? %>
    <%= button_to 'unarchive', unarchive_conversation_path(@conversation), method: :patch,
                  class: 'rounded border border-neutral-700 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200' %>
  <% else %>
    <%= button_to 'archive', archive_conversation_path(@conversation), method: :patch,
                  class: 'rounded border border-neutral-700 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200' %>
  <% end %>
</p>

<%= chat_surface(endpoint: conversation_messages_path(@conversation), fresh: false, conversation: @conversation, messages: @conversation.messages) %>
