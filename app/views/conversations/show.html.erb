<%# The show page: the masthead's edition band carries the conversation's
    working title; the sub-band carries the archive affordance. %>
<% content_for :edition, @conversation.title.presence || '(Untitled)' %>
<% content_for :editions do %>
  <% if @conversation.archived? %>
    <%= button_to 'unarchive', unarchive_conversation_path(@conversation), method: :patch, class: 'c-ed-link cursor-pointer' %>
  <% else %>
    <%= button_to 'archive', archive_conversation_path(@conversation), method: :patch, class: 'c-ed-link cursor-pointer' %>
  <% end %>
<% end %>

<%= chat_surface(endpoint: conversation_messages_path(@conversation), fresh: false, conversation: @conversation, messages: @conversation.messages) %>
