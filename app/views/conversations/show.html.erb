<div class="mx-auto flex h-16 max-w-3xl items-center gap-3 px-5 pt-10 text-sm text-neutral-500">
  <span class="grow truncate"><%= @conversation.title.presence || '(untitled)' %></span>
  <% if @conversation.archived? %>
    <%= button_to 'unarchive', unarchive_conversation_path(@conversation), method: :patch, class: 'cursor-pointer rounded bg-soviet/20 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200 hover:bg-soviet/50' %>
  <% else %>
    <%= button_to 'archive', archive_conversation_path(@conversation), method: :patch, class: 'cursor-pointer rounded bg-soviet/20 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200 hover:bg-soviet/50' %>
  <% end %>
</div>

<%= chat_surface(endpoint: conversation_messages_path(@conversation), fresh: false, conversation: @conversation, messages: @conversation.messages) %>
