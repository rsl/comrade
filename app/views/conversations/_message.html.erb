<%# One transcript turn. Tool exchanges render as quiet chips: the
      assistant's tool_calls frame shows any spoken content only, and each
      tool row becomes a "searched for / fetched" line. Assistant turns with
      citations close with a sources list. %>
<% if message.role == 'tool' %>
  <%# Stray tool rows render bare when nothing follows them. %>
  <p class="text-xs text-neutral-500">
    — <%= message.tool_name == 'web_search' ? "searched for #{ message.tool_payload['arguments']['query'] }" : "fetched #{ message.tool_payload['arguments']['url'] }" %>
  </p>
<% elsif message.role == 'assistant' && message.tool_payload.present? %>
  <% if message.content.present? %>
    <article class="text-neutral-300">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-neutral-500">Comrade</p>
      <%# Assistant content is markdown-rendered HTML: no pre-wrap, the
          renderer's own block tags carry the spacing. %>
      <div class="leading-relaxed"><%= message.content %></div>
    </article>
  <% end %>
<% else %>
  <article class="<%= message.role == 'user' ? 'text-neutral-100' : 'text-neutral-300' %>">
    <p class="mb-1 text-xs font-medium uppercase tracking-wide text-neutral-500">
      <%= message.role == 'user' ? 'You' : 'Comrade' %>
    </p>
    <%# The chips are Comrade's own actions, so they render under their
        name, ahead of the answer — one group carrying the outer spacing,
        tight between themselves. %>
    <div class="mt-2 mb-3">
      <% tool_notes.each do |note| %>
        <p class="mb-1 text-xs text-neutral-500">
          — <%= note.tool_name == 'web_search' ? "searched for #{ note.tool_payload['arguments']['query'] }" : "fetched #{ note.tool_payload['arguments']['url'] }" %>
        </p>
      <% end %>
    </div>
    <div class="<%= message.role == 'user' ? 'whitespace-pre-wrap' : '' %> leading-relaxed"><% if message.role == 'assistant' %><%= cited_paragraphs(message) %><% else %><%= message.content.strip %><% end %></div>
    <% if message.role == 'assistant' && message.citations.blank? %>
      <div class="mt-3 border-t border-ground-bright pt-2 text-xs text-neutral-500">from model knowledge</div>
    <% end %>
  </article>
<% end %>
