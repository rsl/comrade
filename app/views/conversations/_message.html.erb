<%# One transcript article — the piece both renders build, placed by the
    exchange wrapper in _chat.html.erb (question cell or answer stack).
    Tool exchanges render as quiet chips: the assistant's tool_calls frame
    shows any spoken content only, and each tool row becomes a
    "searched for / fetched" line. Sources live in the turn's margin note
    card, not under the paragraphs. The keep-simple offer, when standing,
    rides the latest answer's line — where the break-it-down clicks that
    earned it happened. Byte-identical with the stream reader's client
    render. %>
<% if message.role == 'assistant' && message.tool_payload.present? %>
  <% if message.content.present? %>
    <article>
      <p class="c-turn-label"><span class="c-who-mark">▸</span>Comrade</p>
      <%# Assistant content is markdown-rendered HTML: no pre-wrap, the renderer's own block tags carry the spacing. %>
      <div class="c-answer"><%= message.content %></div>
    </article>
  <% end %>
<% elsif message.role == 'user' %>
  <article>
    <p class="c-turn-label"><span class="c-who-mark">▸</span>You</p>
    <%# Attachments render above the turn's text, the same slot the tool
        chips and image strips take in answers — the strip is the staged
        copies, byte-identical with the stream reader's. %>
    <% if message.images.present? %>
      <%= attachment_strip(message) %>
    <% end %>
    <div class="c-question"><%= message.content.to_s.strip %></div>
  </article>
<% else %>
  <article>
    <p class="c-turn-label"><span class="c-who-mark">▸</span>Comrade</p>
    <% if tool_notes.any? %>
      <div class="c-chip-group">
        <% tool_notes.each do |note| %>
          <p class="c-tool-chip">— <%= tool_note(note) %></p>
        <% end %>
      </div>
      <%# Image-search rows grow a thumbnail strip under the chips — the
          stream render builds it from the images event, this one from the
          row's payload. Byte-identical twins. %>
      <% tool_notes.select { |tool| tool.tool_payload['images'].present? }.each do |tool| %>
        <%= image_strip(tool) %>
      <% end %>
    <% end %>
    <%# Assistant content is markdown-rendered HTML: no pre-wrap, the renderer's own block tags carry the spacing. Inline [n] markers are consumed — their sources print in the turn's note card. %>
    <div class="c-answer"><%= cited_paragraphs(message) %></div>
    <%# The foreman's log rides the action line on the latest stats answer:
        the total time toggles the log, and the log sits collapsed under
        the line. The dot marks every completed turn, gold; the clickable
        total is the latest answer's log affordance. The reload twin of
        what the stream reader swaps in at completion. %>
    <%# The line under the answer: where it came from, and the actions.
        Memory answers name their knowledge and carry break-it-down; the
        latest answer alone carries the actions. Search answers name their
        sources and carry check-sources beside break-it-down — the note
        card holds the sources themselves.
        Byte-identical with the stream reader's client render. %>
    <% if message.citations.blank? %>
      <div class="c-stats-line"><%= standing_dot %>from model knowledge<%= stats_segment(message, clickable: turn_log) %><% if break_down %><span class="break-down-offer"> · <%= link_to 'break it down', '#', data: { action: 'stream-reader#breakDown' }, class: 'break-down' %></span><% end %><% if current_enlistee&.offer_keep_simple? %><span class="keep-simple-offer"> · Simpler by default? <%= link_to 'Yes', calibration_path, data: { turbo_method: :post } %> <%= link_to 'No thanks', calibration_path, data: { turbo_method: :delete } %></span><% end %></div>
    <% elsif break_down %>
      <div class="c-stats-line"><%= standing_dot %>from sources<%= stats_segment(message, clickable: turn_log) %><% if double_check %><span class="double-check-offer"> · <%= link_to 'check sources', '#', data: { action: 'stream-reader#doubleCheck' }, class: 'double-check' %></span><% end %><span class="break-down-offer"> · <%= link_to 'break it down', '#', data: { action: 'stream-reader#breakDown' }, class: 'break-down' %></span><% if current_enlistee&.offer_keep_simple? %><span class="keep-simple-offer"> · Simpler by default? <%= link_to 'Yes', calibration_path, data: { turbo_method: :post } %> <%= link_to 'No thanks', calibration_path, data: { turbo_method: :delete } %></span><% end %></div>
    <% end %>
    <% if turn_log %>
      <%= turn_log_pre(message) %>
    <% end %>
  </article>
<% end %>
