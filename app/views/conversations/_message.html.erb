<%# One transcript turn. Tool exchanges render as quiet chips: the assistant's tool_calls frame shows any spoken content only, and each tool row becomes a "searched for / fetched" line. Assistant turns with citations close with a sources list. %>
<% if message.role == 'tool' %>
  <%# Stray tool rows render bare when nothing follows them. %>
  <%= tag.p '— ' + tool_note(message), class: 'text-xs text-neutral-500' %>
<% elsif message.role == 'assistant' && message.tool_payload.present? %>
  <% if message.content.present? %>
    <%= tag.article class: 'text-neutral-300' do %>
      <%= tag.p 'Comrade', class: 'mb-1 text-xs font-medium uppercase tracking-wide text-neutral-500' %>
      <%# Assistant content is markdown-rendered HTML: no pre-wrap, the renderer's own block tags carry the spacing. %>
      <%= tag.div message.content, class: 'leading-relaxed' %>
    <% end %>
  <% end %>
<% else %>
  <%= tag.article class: message.role == 'user' ? 'text-neutral-100' : 'text-neutral-300' do %>
    <%= tag.p message.role == 'user' ? 'You' : 'Comrade', class: 'mb-1 text-xs font-medium uppercase tracking-wide text-neutral-500' %>
    <%# The chips are Comrade's own actions, so they render under their name, ahead of the answer — one group carrying the outer spacing, tight between themselves. %>
    <%= tag.div class: 'mt-2 mb-3' do %>
      <% tool_notes.each do |note| %>
        <%= tag.p '— ' + tool_note(note), class: 'mb-1 text-xs text-neutral-500' %>
      <% end %>
    <% end %>
    <% if message.role == 'assistant' %>
      <%= tag.div cited_paragraphs(message), class: 'leading-relaxed' %>
    <% else %>
      <%= tag.div message.content.strip, class: 'leading-relaxed whitespace-pre-wrap' %>
    <% end %>
    <% if message.role == 'assistant' && message.citations.blank? %>
      <%= tag.div 'from model knowledge', class: 'mt-3 border-t border-ground-bright pt-2 text-xs text-neutral-500' %>
    <% end %>
  <% end %>
<% end %>
