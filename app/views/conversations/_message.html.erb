<%# One transcript turn. Tool exchanges render as quiet chips: the assistant's tool_calls frame shows any spoken content only, and each tool row becomes a "searched for / fetched" line. Assistant turns with citations close with a sources list. The keep-simple offer, when standing, rides the latest answer's line — where the break-it-down clicks that earned it happened. Byte-identical with the stream reader's client render. %>
<% if message.role == 'tool' %>
  <%# Stray tool rows render bare when nothing follows them. %>
  <p class="text-xs text-neutral-500">— <%= tool_note(message) %></p>
<% elsif message.role == 'assistant' && message.tool_payload.present? %>
  <% if message.content.present? %>
    <article class="text-neutral-300">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-neutral-500">Comrade</p>
      <%# Assistant content is markdown-rendered HTML: no pre-wrap, the renderer's own block tags carry the spacing. %>
      <div class="leading-relaxed"><%= message.content %></div>
    </article>
  <% end %>
<% else %>
  <%= tag.article class: message.role == 'user' ? 'text-neutral-100' : 'text-neutral-300' do %>
    <p class="mb-1 text-xs font-medium uppercase tracking-wide text-neutral-500"><%= message.role == 'user' ? 'You' : 'Comrade' %></p>
    <%# The chips are Comrade's own actions, so they render under their name, ahead of the answer — one group carrying the outer spacing, tight between themselves. Rendered only when notes exist: an empty group div adds height the client render doesn't, and the post-first-reply Turbo.visit swap reflows visibly. (2026-10-24) %>
    <% if tool_notes.any? %>
      <div class="mt-2 mb-3">
        <% tool_notes.each do |note| %>
          <p class="mb-1 text-xs text-neutral-500">— <%= tool_note(note) %></p>
        <% end %>
      </div>
    <% end %>
    <% if message.role == 'assistant' %>
      <div class="leading-relaxed"><%= cited_paragraphs(message) %></div>
    <% else %>
      <div class="leading-relaxed whitespace-pre-wrap"><%= message.content.strip %></div>
    <% end %>
    <% if message.role == 'assistant' %>
      <%# The line under the answer: where it came from, and the actions.
          Memory answers name their knowledge; the latest answer alone
          carries the actions (two links would be two guesses at a target).
          Search answers carry chips per paragraph and only the action line.
          Byte-identical with the stream reader's client render. %>
      <% if message.citations.blank? %>
        <div class="mt-3 border-t border-ground-bright pt-2 text-xs text-neutral-500">From model knowledge<% if double_check %><span class="double-check-offer"> · <%= link_to 'Double check', '#', data: { action: 'stream-reader#doubleCheck' }, class: 'double-check cursor-pointer underline hover:text-neutral-300' %></span><% end %><% if break_down %><span class="break-down-offer"> · <%= link_to 'Break it down', '#', data: { action: 'stream-reader#breakDown' }, class: 'break-down cursor-pointer underline hover:text-neutral-300' %></span><% end %><% if current_enlistee&.offer_keep_simple? %><span class="keep-simple-offer"> · Simpler by default? <%= link_to 'Yes', calibration_path, data: { turbo_method: :post }, class: 'cursor-pointer underline hover:text-neutral-300' %> <%= link_to 'No thanks', calibration_path, data: { turbo_method: :delete }, class: 'cursor-pointer text-neutral-500 hover:text-neutral-300' %></span><% end %></div>
      <% elsif break_down %>
        <div class="break-down-offer mt-3 border-t border-ground-bright pt-2 text-xs text-neutral-500"><%= link_to 'Break it down', '#', data: { action: 'stream-reader#breakDown' }, class: 'break-down cursor-pointer underline hover:text-neutral-300' %><% if current_enlistee&.offer_keep_simple? %><span class="keep-simple-offer"> · Simpler by default? <%= link_to 'Yes', calibration_path, data: { turbo_method: :post }, class: 'cursor-pointer underline hover:text-neutral-300' %> <%= link_to 'No thanks', calibration_path, data: { turbo_method: :delete }, class: 'cursor-pointer text-neutral-500 hover:text-neutral-300' %></span><% end %></div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
