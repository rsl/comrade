<%# The conversation listing — the full Recent page and the archives share one shape: grouped by when they were asked (Today, Yesterday, Monday-anchored weeks), each row carrying its ask date and the conversation's whole first line. Row controls follow the listing: the all page archives or destroys, the archives unarchives or destroys. %>
<section class="mx-auto flex w-full max-w-3xl min-h-0 flex-1 flex-col overflow-y-auto px-5 pb-10 pt-10">
  <%# The poster voice echoes the masthead; the opposite listing sits across from it. %>
  <div class="mb-4 flex items-baseline justify-between">
    <h2 class="font-poster text-lg font-semibold uppercase tracking-wide text-newsprint"><%= heading %></h2>
    <%= link_to cross_link_label, cross_link_path, class: 'c-ed-link' %>
  </div>
  <% time_groups(conversations).each do |heading_bucket, bucket_conversations| %>
    <h3 class="c-col-head mb-1 mt-4"><%= heading_bucket %></h3>
    <ul class="flex flex-col gap-1">
      <% bucket_conversations.each do |conversation| %>
        <%# The listing_ prefix keeps this row's id distinct from the rail's dom_id row — the archive action removes both, and Turbo's remove only hits the first id match. %>
        <%= tag.li id: "listing_#{dom_id(conversation)}", class: 'flex items-baseline gap-2' do %>
          <span class="w-32 shrink-0 font-mono text-[0.594rem] text-kiosk"><%= conversation.created_at.strftime('%b %-d, %-l:%M%P') %></span>
          <%= link_to archive_line(conversation), conversation_path(conversation), class: 'grow px-2 py-1 font-serif text-newsprint-dim hover:bg-panel hover:text-newsprint' %>
          <% if archived %>
            <%= button_to 'Unarchive', unarchive_conversation_path(conversation), method: :patch, class: 'cursor-pointer border border-hairline px-2 py-0.5 font-mono text-[0.594rem] uppercase text-kiosk hover:text-newsprint' %>
          <% else %>
            <%= button_to 'Archive', archive_conversation_path(conversation), method: :patch, class: 'cursor-pointer border border-hairline px-2 py-0.5 font-mono text-[0.594rem] uppercase text-kiosk hover:text-newsprint' %>
          <% end %>
          <%= button_to 'Destroy', conversation_path(conversation), method: :delete, data: { turbo_confirm: "Delete '#{ conversation.title.presence || 'Untitled' }' and its messages forever?" }, class: 'cursor-pointer border border-red-deep px-2 py-0.5 font-mono text-[0.594rem] uppercase text-red-text hover:text-newsprint' %>
        <% end %>
      <% end %>
    </ul>
  <% end %>
  <% if conversations.empty? %>
    <p class="px-2 font-serif text-sm text-kiosk"><%= empty_text %></p>
  <% end %>
  <%= link_to '← live conversations', root_path, class: 'c-ed-link mt-3 inline-block' %>
</section>
