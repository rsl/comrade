<%# The conversation listing — the full Recent page and the archives share one shape: grouped by when they were asked (Today, Yesterday, Monday-anchored weeks), each row carrying its ask date and the conversation's whole first line. Row controls follow the listing: the all page archives or destroys, the archives unarchives or destroys. %>
<section class="mx-auto flex w-full max-w-3xl min-h-0 flex-1 flex-col overflow-y-auto px-5 pb-10 pt-10">
  <%# The gold heading echoes the Comrade wordmark; the opposite listing sits across from it. %>
  <div class="mb-4 flex items-baseline justify-between">
    <h2 class="text-lg font-semibold tracking-tight text-gold"><%= heading %></h2>
    <%= link_to cross_link_label, cross_link_path, class: 'text-xs text-neutral-500 hover:text-gold' %>
  </div>
  <% time_groups(conversations).each do |heading_bucket, bucket_conversations| %>
    <h3 class="mb-1 mt-4 text-xs font-medium uppercase tracking-wide text-neutral-500"><%= heading_bucket %></h3>
    <ul class="flex flex-col gap-1">
      <% bucket_conversations.each do |conversation| %>
        <%# The listing_ prefix keeps this row's id distinct from the sidebar's dom_id row — the archive action removes both, and Turbo's remove only hits the first id match. %>
        <%= tag.li id: "listing_#{dom_id(conversation)}", class: 'flex items-baseline gap-2' do %>
          <span class="w-32 shrink-0 text-xs text-neutral-600"><%= conversation.created_at.strftime('%b %-d, %-l:%M%P') %></span>
          <%= link_to archive_line(conversation), conversation_path(conversation), class: 'grow rounded px-2 py-1 text-neutral-400 hover:bg-neutral-900 hover:text-neutral-200' %>
          <% if archived %>
            <%= button_to 'Unarchive', unarchive_conversation_path(conversation), method: :patch, class: 'rounded border border-neutral-700 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200' %>
          <% else %>
            <%= button_to 'Archive', archive_conversation_path(conversation), method: :patch, class: 'rounded border border-neutral-700 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200' %>
          <% end %>
          <%= button_to 'Destroy', conversation_path(conversation), method: :delete, data: { turbo_confirm: "Delete '#{ conversation.title.presence || 'Untitled' }' and its messages forever?" }, class: 'rounded border border-red-900 px-2 py-0.5 text-xs text-red-500 hover:text-red-300' %>
        <% end %>
      <% end %>
    </ul>
  <% end %>
  <% if conversations.empty? %>
    <p class="px-2 text-sm text-neutral-600"><%= empty_text %></p>
  <% end %>
  <%= link_to '← live conversations', root_path, class: 'mt-3 inline-block text-xs text-neutral-500 hover:text-neutral-300' %>
</section>
