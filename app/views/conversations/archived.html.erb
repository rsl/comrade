<%# The archived listing: read-only titles with the only door to real destruction. Living here keeps destroy two steps from the live list. %>
<section class="mx-auto max-w-3xl px-5 pb-10 pt-10">
  <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Archived</h2>
  <ul class="flex flex-col gap-1">
    <% @conversations.each do |conversation| %>
      <li class="flex items-center gap-2">
        <%= link_to conversation.title.presence || '(Untitled)', conversation_path(conversation), class: 'grow truncate rounded px-2 py-1 text-neutral-400 hover:bg-neutral-900 hover:text-neutral-200' %>
        <%= button_to 'unarchive', unarchive_conversation_path(conversation), method: :patch, class: 'rounded border border-neutral-700 px-2 py-0.5 text-xs text-neutral-500 hover:text-neutral-200' %>
        <%= button_to 'Destroy', conversation_path(conversation), method: :delete, data: { turbo_confirm: "Delete '#{ conversation.title.presence || 'Untitled' }' and its messages forever?" }, class: 'rounded border border-red-900 px-2 py-0.5 text-xs text-red-500 hover:text-red-300' %>
      </li>
    <% end %>
  </ul>
  <% if @conversations.empty? %>
    <p class="px-2 text-sm text-neutral-600">Nothing archived.</p>
  <% end %>
  <%= link_to '← live conversations', root_path, class: 'mt-3 inline-block text-xs text-neutral-500 hover:text-neutral-300' %>
</section>
