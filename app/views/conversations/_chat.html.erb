<div
  data-controller="stream-reader"
  data-stream-reader-endpoint-value="<%= endpoint %>"
  data-stream-reader-fresh-value="<%= fresh %>"
  class="flex min-h-screen flex-col"
>
  <%# Reserve the title/archive line's height on pages that don't render
      it yet, so the Turbo visit after the first reply doesn't shove the
      transcript down. Height is pinned, not content-driven: Safari sizes
      the real row's button differently than Chrome, and a content-matched
      spacer jitters anyway. %>
  <% if fresh %>
    <div class="mx-auto flex h-16 max-w-3xl items-center gap-3 px-5 pt-10 text-sm invisible" aria-hidden="true">
      <span class="grow truncate">placeholder</span>
    </div>
  <% end %>
  <div
    id="transcript"
    data-stream-reader-target="transcript"
    class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 px-5 py-10 <%= 'justify-center' if messages.empty? %>"
  >
    <% if messages.empty? %>
      <div class="greeting text-center">
        <p class="text-3xl font-semibold tracking-tight text-gold">Comrade</p>
        <p class="mt-2 text-sm text-neutral-500">Seize the means of information retrieval.</p>
      </div>
    <% end %>
    <%# Tool notes group into the message that answers them — the chips
      belong to the reply, not floating between turns. %>
  <% pending_tools = [] %>
  <% messages.each do |message| %>
    <% if message.role == 'tool' %>
      <% pending_tools << message %>
    <% elsif message.role == 'assistant' && message.tool_payload.present? && message.content.blank? %>
      <%# A tool_calls frame with no spoken content renders nothing — and
          must not flush the chips pending for the answering turn. %>
    <% else %>
      <%= message_turn(message, tool_notes: pending_tools) %>
      <% pending_tools = [] %>
    <% end %>
  <% end %>
  <% pending_tools.each do |tool| %>
    <p class="text-xs text-neutral-500">— <%= tool.tool_name == 'web_search' ? "searched for #{ tool.tool_payload['arguments']['query'] }" : "fetched #{ tool.tool_payload['arguments']['url'] }" %></p>
  <% end %>
  </div>

  <div class="sticky bottom-0 bg-ground/90 pb-6 pt-2 backdrop-blur">
    <form
      data-turbo="false"
      data-stream-reader-target="form"
      data-action="submit->stream-reader#submit"
      class="mx-auto flex max-w-3xl items-end px-5"
    >
      <textarea
        name="content"
        rows="1"
        required
        placeholder="<%= messages.any? ? 'Reply…' : 'What do you need, comrade?' %>"
        data-action="keydown->stream-reader#keydown"
        class="peer grow resize-none rounded-l-lg bg-neutral-300 px-4 py-3 leading-snug text-neutral-900 placeholder:text-neutral-500 focus:bg-neutral-100 focus:outline-none"
      ></textarea>
      <button
        type="submit"
        class="min-w-[4.5rem] cursor-pointer rounded-r-lg bg-soviet/50 px-4 py-3 font-medium leading-snug text-white peer-focus:bg-soviet/80 hover:bg-soviet"
      >Ask</button>
    </form>
  </div>
</div>
