<%# A pending turn rides as data: the stream reader auto-resumes it on
    connect (the answer to a search-handoff GET, or a reload mid-stream).
    The content rides along — the resume is a retry, and the server
    matches the retry to its row on this exact text. %>
<% pending = pending_user_row(messages) %>
<%= tag.div 'data-controller': 'stream-reader', 'data-stream-reader-endpoint-value': endpoint, 'data-stream-reader-fresh-value': fresh, 'data-stream-reader-keep-simple-value': current_enlistee&.offer_keep_simple? ? true : false, 'data-stream-reader-pending-value': pending.present?, 'data-stream-reader-pending-content-value': pending&.content.to_s, class: 'flex min-h-0 flex-1 flex-col' do %>
  <%# Gated: a tokenless browser on an empty chat — the enlist card owns
      the ask, the composer waits hidden, and the card centers on the
      sheet. "Stay in the commune" reveals composer and rail client-side. %>
  <% gated = current_enlistee.blank? && messages.empty? %>
  <%# The desk: sheet, sources well, and spine as background layers; the
      scroller above them; the composer strip in the transcript column,
      the sources well running on beside it. The masthead's edition band
      (the layout's) is the reserved title row's heir — the stream reader
      fills it with the working title on fresh pages. %>
  <div class="c-desk">
    <div class="c-sheet"></div>
    <div class="c-sources-well"></div>
    <div class="c-spine"></div>
    <div id="transcript" data-stream-reader-target="transcript" class="c-scroll">
      <% if messages.empty? %>
        <%# Gate: every fresh load of the new-chat surface asks — no cookie,
            no memory. "Stay in the commune" reveals the composer for this
            view only (client-side); a handle is the permanent way out. %>
        <% if current_enlistee.blank? %>
          <%# Copy is first-pass; the tweaking stage owns the final words.
              The paragraph explains where comrade lives so the
              household-open vs handle-kept choice has context. %>
          <%# Centering is my-auto, not justify-center: auto margins vanish
              when the card outgrows the panel (keyboard-open phone, large
              font scale), so the top stays scrollable — justify-center
              clips it unreachably. %>
          <%= tag.div class: 'enlist-card my-auto px-8 text-center sm:mr-[260px]', 'data-stream-reader-target': 'gate' do %>
            <p class="font-poster text-3xl font-semibold uppercase tracking-tight text-newsprint">Comrade</p>
            <p class="c-tagline mt-2">Seize the means of information retrieval.</p>
            <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-newsprint-dim">Comrade runs on a machine in this house. The model that answers lives here, the record of what's asked stays here, and the only people who can reach it are on this network. When you search, the question goes out to the open web — that's what searching is.</p>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-newsprint-dim">The commune takes anyone, and what's asked there sits in the open for the whole household. Or use a handle, and your conversations stay under it: not really private, but basically, yeh?</p>
            <%= form_with url: enlistment_path, class: 'mx-auto mt-6 flex max-w-md items-center' do |form| %>
              <%= form.text_field :name, required: true, maxlength: 40, autocomplete: 'off',
                    placeholder: 'What should we call you?', 'aria-label': 'What should we call you?',
                    class: 'min-w-0 grow border border-hairline bg-panel px-4 py-3 font-serif leading-snug text-newsprint placeholder:text-kiosk focus:border-kiosk focus:outline-none' %>
              <%= form.button 'Enlist', class: 'min-w-[4.5rem] cursor-pointer bg-soviet px-4 py-3 font-poster uppercase tracking-widest leading-snug text-newsprint hover:bg-red-deep' %>
            <% end %>
            <p class="mt-3 font-mono text-[0.594rem] tracking-wide text-kiosk">or
              <%= link_to 'Stay in the commune', '#',
                    data: { action: 'stream-reader#stayInCommune' },
                    class: 'cursor-pointer underline hover:text-newsprint' %>
            </p>
          <% end %>
          <%# Revealed with the composer when the reader stays in the commune:
              the gate branch carries its own greeting so the revealed state
              looks like the enlisted empty chat. %>
          <%= tag.div class: 'greeting my-auto text-center sm:mr-[260px]', hidden: true, 'data-stream-reader-target': 'greeting' %>
        <% else %>
          <div class="greeting my-auto text-center sm:mr-[260px]"></div>
        <% end %>
      <% else %>
        <div class="c-cols">
          <div class="c-col-head c-head-q">Current</div>
          <div class="c-col-head c-head-sources">Sources</div>
          <% latest_user = messages.reverse.detect { |message| message.role == 'user' } %>
          <% grouped_exchanges(messages).each do |exchange| %>
            <div class="c-turn">
              <% if exchange[:user] %>
                <div class="c-q">
                  <%# Node squares on the spine: gold for the latest turn,
                      red for turns already answered — the stream reader
                      demotes and re-marks as turns stream in. %>
                  <span class="<%= class_names('c-node', 'c-node-live': exchange[:user].id == latest_user&.id) %>"></span>
                  <%= message_turn(exchange[:user], tool_notes: [], double_check: false, break_down: false, turn_log: false) %>
                </div>
              <% end %>
              <div class="c-a-wrap">
                <% if exchange[:answer] %>
                  <%= message_turn(exchange[:answer], tool_notes: exchange[:tools], double_check: exchange[:answer].id == break_down_id(messages) && exchange[:answer].citations.present?, break_down: exchange[:answer].id == break_down_id(messages), turn_log: exchange[:answer].id == turn_status_id(messages)) %>
                <% elsif exchange[:tools].any? %>
                  <%# Tools that never got their answer render bare. %>
                  <% exchange[:tools].each do |tool| %>
                    <p class="c-tool-chip">— <%= tool_note(tool) %></p>
                  <% end %>
                <% end %>
              </div>
              <% if exchange[:note] %>
                <%= note_card(exchange) %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <%# Gated on an empty chat: the composer sits here but hidden — the
        gate card owns the ask until "stay in the commune" reveals it.
        Everywhere else the composer just is. %>
    <%# Staged attachments: what the next send carries, one chip per
        image — thumbnail, resolved size (with the original when staging
        shrank it), and a remove button. Hidden while empty; the
        stream reader owns every child. %>
    <div class="<%= class_names('c-composer', 'hidden': gated) %>" data-stream-reader-target="composer">
      <div data-stream-reader-target="staged" class="hidden flex-wrap gap-2 px-4 pb-2 pt-2"></div>
      <%= tag.form data: { turbo: false, 'stream-reader-target': 'form', action: 'submit->stream-reader#submit' }, class: 'c-cline' do %>
        <%# The attach segment: opens the file picker (on iOS that IS the
            Photos picker — the only mobile flow). Drag-anywhere, paste, and
            this button all stage through the same path; the staged chips
            box above the composer shows what a send will carry. %>
        <button type="button" data-action="stream-reader#pickAttachments" aria-label="Attach images" class="c-attach">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48" /></svg>
        </button>
        <%# Not required: an image-only send carries no text, so the
            empty-send gate lives in the stream reader's submit. %>
        <%# The autofocus attribute is rsl's call (2026-11-14, "autofocus
            being fixed fixes all") after the attribute-era vs no-attribute
            tests on the iPad contradicted the sabotage theory. The
            !messages.any? guard keeps the show-page no-steal rule:
            opening an old conversation never grabs focus — only a fresh
            chat claims it natively, and the connect() retries (rAF,
            200ms) back it up for the iPad's dropped UI half. %>
        <%= tag.textarea nil, name: 'content', rows: 1, autofocus: !messages.any?, placeholder: messages.any? ? 'Reply…' : 'What do you need, comrade?', 'aria-label': messages.any? ? 'Reply' : 'Ask comrade', 'data-action': 'keydown->stream-reader#keydown paste->stream-reader#paste', 'data-short-placeholder': messages.any? ? nil : 'Sup, comrade?', class: 'c-cline-input' %>
        <%# The answer-mode switch: what this one ask rides. "all" is the
            unforced mode — knowledge, web search, page fetch, the model's
            pick per question; "images" narrows the turn to pictures. It
            names the toolbox, not a source, so no turn is mislabeled.
            Per-turn — it reverts to all after sending, like the composer
            clearing; a retried turn replays its mode. The active mode
            reads newsprint on the red wash with the inset red underline. %>
        <div class="flex shrink-0 items-stretch" role="group" aria-label="Answer mode">
          <button type="button" data-stream-reader-target="webMode" data-action="stream-reader#pickWebMode" class="c-modebtn on">all</button>
          <button type="button" data-stream-reader-target="imageMode" data-action="stream-reader#pickImageMode" class="c-modebtn">images</button>
        </div>
        <button type="submit" data-action="mousedown->stream-reader#holdFocus" class="c-askbtn">Ask</button>
        <input type="file" accept="image/*" multiple hidden data-stream-reader-target="fileInput" data-action="change->stream-reader#pickFiles">
      <% end %>
    </div>
  </div>
  <%# Drop anywhere on the conversation: the overlay is fixed to the
      shell (the document never scrolls), so it adds nothing to the
      layout — the inset-shell law in docs/design.md holds. %>
  <div data-stream-reader-target="dropOverlay" class="fixed inset-0 z-30 hidden items-center justify-center border-2 border-dashed border-gold bg-press-dark/80" data-action="dragleave->stream-reader#hideDropOverlay drop->stream-reader#hideDropOverlay">
    <p class="font-mono text-sm tracking-wide text-gold">drop images to attach</p>
  </div>
<% end %>
