<%= tag.div 'data-controller': 'stream-reader', 'data-stream-reader-endpoint-value': endpoint, 'data-stream-reader-fresh-value': fresh, class: 'flex min-h-screen flex-col' do %>
  <%# Reserve the title/archive line's height on pages that don't render it yet, so the Turbo visit after the first reply doesn't shove the transcript down. Height is pinned, not content-driven: Safari sizes the real row's button differently than Chrome, and a content-matched spacer jitters anyway. %>
  <% if fresh %>
    <%= tag.div class: 'mx-auto flex h-16 max-w-3xl items-center gap-3 px-5 pt-10 text-sm invisible', aria: { hidden: true } do %><%= tag.span 'placeholder', class: 'grow truncate' %><% end %>
  <% end %>
  <%= tag.div id: 'transcript', 'data-stream-reader-target': 'transcript', class: class_names('mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 px-5 py-10', 'justify-center': messages.empty?) do %>
    <% if messages.empty? %>
      <%= tag.div class: 'greeting text-center' do %>
        <%= tag.p 'Comrade', class: 'text-3xl font-semibold tracking-tight text-gold' %>
        <%= tag.p 'Seize the means of information retrieval.', class: 'mt-2 text-sm text-neutral-500' %>
      <% end %>
    <% end %>
    <% grouped_turns(messages).each do |message, tool_notes| %>
      <%= message_turn(message, tool_notes:) %>
    <% end %>
  <% end %>
  <%= tag.div class: 'sticky bottom-0 bg-ground/90 pb-6 pt-2 backdrop-blur' do %>
    <%= tag.form 'data-turbo': 'false', 'data-stream-reader-target': 'form', 'data-action': 'submit->stream-reader#submit', class: 'mx-auto flex max-w-3xl items-end px-5' do %>
      <%= tag.textarea nil, name: 'content', rows: 1, required: true, placeholder: messages.any? ? 'Reply…' : 'What do you need, comrade?', 'data-action': 'keydown->stream-reader#keydown', class: 'peer grow resize-none rounded-l-lg bg-neutral-300 px-4 py-3 leading-snug text-neutral-900 placeholder:text-neutral-500 focus:bg-neutral-100 focus:outline-none' %>
      <%= tag.button 'Ask', type: 'submit', class: 'min-w-[4.5rem] cursor-pointer rounded-r-lg bg-soviet/50 px-4 py-3 font-medium leading-snug text-white peer-focus:bg-soviet/80 hover:bg-soviet' %>
    <% end %>
  <% end %>
<% end %>
