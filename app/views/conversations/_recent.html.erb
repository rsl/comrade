<section class="mx-auto max-w-2xl px-5 pb-10">
  <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Recent</h2>
  <ul class="flex flex-col gap-1">
    <% conversations.each do |conversation| %>
      <li>
        <%= link_to conversation.title.presence || '(untitled)', conversation_path(conversation),
                    class: 'block truncate rounded px-2 py-1 text-neutral-400 hover:bg-neutral-900 hover:text-neutral-200' %>
      </li>
    <% end %>
  </ul>
</section>
