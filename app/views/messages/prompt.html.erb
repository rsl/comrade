<%# The prompt inspector: the wire request an answer's turn rode, rebuilt from the transcript plus the current prompt file and prefs. A reconstruction, not a snapshot — the note says so. %>
<section class="mx-auto flex w-full max-w-3xl min-h-0 flex-1 flex-col overflow-y-auto px-5 pb-10 pt-10">
  <h2 class="c-col-head mb-2">The turn's request</h2>
  <p class="mb-4 font-mono text-[0.594rem] text-kiosk">Rebuilt from the transcript with the current prompt file and prefs — a reconstruction, not a stored snapshot of the turn.</p>
  <pre class="whitespace-pre-wrap font-mono text-xs leading-relaxed text-newsprint-dim"><%= wire_request_json(@request) %></pre>
  <%= link_to '← back', conversation_path(@conversation), class: 'c-ed-link mt-4 inline-block' %>
</section>
