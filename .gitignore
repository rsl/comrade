# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*

# Ignore all private key / credential files
/config/master.key
/config/credentials/*.key

# Ignore files under vendor
/vendor/bundle

# Ignore node modules
/node_modules

# Ignore precompiled javascript packs
/public/packs
/public/packs-md5
/public/assets

# Ignore .env files
.env

# Agent design contract — private by decision; public content lives in docs/
.agent-notes/roadmap.md

# Personal prompt override — the shipped voice lives in comrade_prompt.md
/config/comrade_prompt.custom.md
/app/assets/builds/*
!/app/assets/builds/.keep

# Session handoffs: ephemeral working state, not source. Born untracked,
# archived locally by the successor, expired by `agency notes expire`. The
# durable record lives in roadmap.md and docs/ — a handoff never needed a
# commit, and committing one puts a bookkeeping commit on whatever branch
# the close-out runs on (main included, where commits are forbidden).
.agent-notes/sessions/
.agent-notes/archive/
